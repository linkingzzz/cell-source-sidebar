<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="TaskPaneApp">
  <Id>685A162B-4215-4F8B-96BF-63C9D19E8A35</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>cell-source-sidebar</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="Cell Source Sidebar" />
  <Description DefaultValue="Show/edit cell data source in sidebar" />
  <IconUrl DefaultValue="https://localhost:3000/assets/icon-32.png" />
  <SupportUrl DefaultValue="https://github.com/linkingzzz/cell-source-sidebar" />
  <Hosts>
    <Host Name="Workbook" />
  </Hosts>
  <DefaultSettings>
    <SourceLocation DefaultValue="https://localhost:3000/taskpane.html" />
  </DefaultSettings>
  <Permissions>ReadWriteDocument</Permissions>

  <VersionOverrides xmlns="http://schemas.microsoft.com/office/taskpaneappversionoverrides" xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0" xsi:type="VersionOverridesV1_0">
    <Hosts>
      <Host xsi:type="Workbook">
        <DesktopFormFactor>
          <FunctionFile resid="Commands.Url" />
          <ExtensionPoint xsi:type="PrimaryCommandSurface">
            <CustomTab id="CellSourceSidebar.Tab">
              <Group id="CellSourceSidebar.Group">
                <Label resid="Group.Label" />
                <Icon>
                  <bt:Image size="16" resid="Icon.16" />
                  <bt:Image size="32" resid="Icon.32" />
                  <bt:Image size="80" resid="Icon.80" />
                </Icon>
                <Control xsi:type="Button" id="CellSourceSidebar.AddBtn">
                  <Label resid="Add.Label" />
                  <Supertip>
                    <Title resid="Add.Label" />
                    <Description resid="Add.Tip" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16" />
                    <bt:Image size="32" resid="Icon.32" />
                    <bt:Image size="80" resid="Icon.80" />
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>CellSourceSidebarPane</TaskpaneId>
                    <SourceLocation resid="Taskpane.Url" />
                  </Action>
                </Control>
                <Control xsi:type="Button" id="CellSourceSidebar.DelBtn">
                  <Label resid="Del.Label" />
                  <Supertip>
                    <Title resid="Del.Label" />
                    <Description resid="Del.Tip" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16" />
                    <bt:Image size="32" resid="Icon.32" />
                    <bt:Image size="80" resid="Icon.80" />
                  </Icon>
                  <Action xsi:type="ExecuteFunction">
                    <FunctionName>deleteAnnotation</FunctionName>
                  </Action>
                </Control>
              </Group>
              <Label resid="Tab.Label" />
            </CustomTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>
    <Resources>
      <bt:Images>
        <bt:Image id="Icon.16" DefaultValue="https://localhost:3000/assets/icon-16.png" />
        <bt:Image id="Icon.32" DefaultValue="https://localhost:3000/assets/icon-32.png" />
        <bt:Image id="Icon.80" DefaultValue="https://localhost:3000/assets/icon-80.png" />
      </bt:Images>
      <bt:Urls>
        <bt:Url id="Taskpane.Url" DefaultValue="https://localhost:3000/taskpane.html" />
        <bt:Url id="Commands.Url" DefaultValue="https://localhost:3000/commands.html" />
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="Tab.Label" DefaultValue="单元格来源" />
        <bt:String id="Group.Label" DefaultValue="侧边栏批注" />
        <bt:String id="Add.Label" DefaultValue="添加侧边栏批注" />
        <bt:String id="Del.Label" DefaultValue="删除侧边栏批注" />
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="Add.Tip" DefaultValue="打开侧边栏，编辑当前单元格的批注（附件 / 明细表 / 备注）" />
        <bt:String id="Del.Tip" DefaultValue="删除当前单元格的批注及其附件" />
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>